# AuditLens Frontend Environment Configuration
# Set this to your deployed backend URL in production (e.g., on Vercel)
# Leave empty or omitted in local development to use Vite's built-in /api proxy.
# DO NOT include trailing slash.
# Example: https://auditlens-backend.railway.app
VITE_API_BASE_URL=http://127.0.0.1:8000
